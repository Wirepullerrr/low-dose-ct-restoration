{
  "milestone": "5 - evaluation framework and degraded baseline",
  "method": "degraded_baseline",
  "method_description": "No restoration. The degraded image is returned unchanged, so these numbers are the image-quality cost of the frozen synthetic degradation and the floor every later method is compared against.",
  "split": "validation",
  "patients": 6,
  "slices": 885,
  "subject_ids": [
    "4",
    "14",
    "17",
    "23",
    "24",
    "34"
  ],
  "evaluation_config": {
    "data_range": 1.0,
    "ssim": {
      "win_size": 11,
      "gaussian_weights": true,
      "sigma": 1.5,
      "use_sample_covariance": false,
      "data_range": 1.0
    },
    "body_mask": {
      "threshold_hu": -500.0,
      "connectivity": 8,
      "keep_largest_component": true,
      "fill_holes": true,
      "resize_interpolation": "nearest"
    },
    "aggregation": {
      "slice_to_patient": "arithmetic_mean",
      "patient_to_split": "arithmetic_mean",
      "primary_unit": "patient"
    }
  },
  "degradation_config": {
    "algorithm": "correlated_heteroscedastic_gaussian_v1",
    "global_seed": 2026,
    "sigma_floor": 0.015,
    "sigma_signal": 0.035,
    "correlation_sigma_px": 0.6,
    "clip_min": 0.0,
    "clip_max": 1.0
  },
  "preprocessing": {
    "window_center": 40,
    "window_width": 400,
    "image_size": [
      256,
      256
    ],
    "interpolation": "area"
  },
  "primary_result": {
